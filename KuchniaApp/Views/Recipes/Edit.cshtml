@model KuchniaApp.ViewModels.RecipeFormViewModel

@{
    ViewData["Title"] = "Edytuj przepis";
}

<div class="container mt-4">
    <h2>Edytuj przepis</h2>
    <form asp-action="Edit" asp-route-id="@Model.Recipe.Id" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Recipe.Id" />
        <input type="hidden" asp-for="Recipe.CreatedAt" />
        <partial name="_RecipeForm" model="Model" />
        <button type="submit" class="btn btn-warning">Zapisz zmiany</button>
        <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
    </form>
</div>